# =========================================================================
# Talent Screening Platform - Backend Environment Configurations
# Copy this file to '.env' and populate your real API credentials.
# Note: Pydantic Settings expects the 'TALENT_' prefix for all variables.
# =========================================================================

# --- 1. Database & Cache ---
# Database connection string (defaults to local PostgreSQL)
TALENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_screening
# Redis url for caching (defaults to local Redis)
TALENT_REDIS_URL=redis://localhost:6379/0

# --- 2. Security ---
# Secret key used for signing Recruiter JWT Auth tokens (generate a long random string)
TALENT_SECRET_KEY=change-me-to-a-random-secret-key-32-characters-long

# --- 3. Groq API (Primary LLM Engine) ---
# Acquire your Groq API key from https://console.groq.com/keys
TALENT_GROQ_API_KEY=
# LLM Model choices: llama-3.1-8b-instant, llama3-70b-8192, mixtral-8x7b-32768
TALENT_GROQ_MODEL=llama-3.1-8b-instant

# --- 4. Google Search API (Scraper Sourcing) ---
# Acquire your Google Custom Search JSON API Key from Google Cloud Console
TALENT_GOOGLE_SEARCH_API_KEY=
# Create and acquire a Custom Search Engine ID (CSE ID) from https://programmablesearchengine.google.com/
# Set it up to search the web (e.g. searching 'site:linkedin.com/in')
TALENT_GOOGLE_CSE_ID=

# --- 5. Supabase Storage (Video Uploads & Resumes) ---
# Storage backend: "local" (default) or "supabase"
TALENT_STORAGE_BACKEND=local
# Local upload directory path (if STORAGE_BACKEND is "local")
TALENT_UPLOAD_DIR=./uploads
# If STORAGE_BACKEND is "supabase", set your project credentials:
# Project URL (e.g., https://xxxxxxxxxxxxxx.supabase.co)
TALENT_SUPABASE_URL=
# Service Role Key (secret api key for server access, from Project Settings -> API)
TALENT_SUPABASE_SERVICE_KEY=

# --- 6. Gmail SMTP Email (Interview invitations) ---
TALENT_EMAIL_HOST=smtp.gmail.com
TALENT_EMAIL_PORT=587
# Recruiter Gmail address (e.g. sender@gmail.com)
TALENT_EMAIL_USER=
# Gmail App Password (generate from: Google Account Settings -> Security -> App Passwords)
# Do NOT use your raw Gmail account password here.
TALENT_EMAIL_PASSWORD=
# Email address displayed to candidates in their inbox
TALENT_FROM_EMAIL=noreply@talentscreening.com
