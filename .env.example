# Talent Screening Platform - Environment Variables (Backend)
# Copy this file to backend/.env and fill in the values

# Database
TALENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_screening

# Redis
TALENT_REDIS_URL=redis://localhost:6379/0

# Security
TALENT_SECRET_KEY=change-me-to-a-random-secret-key-32-characters-long
TALENT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / Ollama
TALENT_OLLAMA_BASE_URL=http://localhost:11434
TALENT_OLLAMA_MODEL=qwen3

# External APIs
TALENT_TINYFISH_API_KEY=your-tinyfish-api-key

# Storage
TALENT_STORAGE_BACKEND=local
TALENT_UPLOAD_DIR=./uploads

# Email (Gmail SMTP)
TALENT_EMAIL_HOST=smtp.gmail.com
TALENT_EMAIL_PORT=587
TALENT_EMAIL_USER=your-email@gmail.com
TALENT_EMAIL_PASSWORD=your-app-password
TALENT_FROM_EMAIL=noreply@talentscreening.com

# Transcription
TALENT_WHISPER_MODEL_SIZE=base

# CORS (comma-separated)
TALENT_CORS_ORIGINS=http://localhost:5173,http://localhost:19006
