# =========================================================================
# Talent Screening Platform - Mobile Expo App Environment Configurations
# Copy this file to '.env' inside the /mobile directory.
# =========================================================================

# The base URL of the FastAPI backend.
# IMPORTANT: When running the Expo app on a physical device, 'localhost' will not resolve.
# Use your computer's LAN IP address (e.g. http://192.168.x.x:8000/api/v1) or your live deployed Railway URL.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
