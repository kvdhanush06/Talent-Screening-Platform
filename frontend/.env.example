# The API base URL of the FastAPI backend.
# Default is http://localhost:8000/api/v1 for local testing.
# For production deployments, replace with your live backend URL (e.g. https://your-app.up.railway.app/api/v1).
VITE_API_URL=http://localhost:8000/api/v1
